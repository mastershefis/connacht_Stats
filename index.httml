<!doctype html><html><head><meta charset=utf8><meta name=viewport content="width=device-width,initial-scale=1,viewport-fit=cover"><style>:root{color-scheme:light;box-sizing:border-box;padding-top:env(safe-area-inset-top,0px);padding-bottom:env(safe-area-inset-bottom,0px)}html{scroll-padding-top:env(safe-area-inset-top,0px)}body{margin:0;padding:0;font:14px -apple-system,BlinkMacSystemFont,sans-serif;background:#fff;color:#000}img{max-width:100%}[hidden]:not([hidden=until-found i]){display:none!important}</style></head><body>
<title>Connacht v Leinster</title>
<meta name="claude:viewport-fit-sides" content="cover">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Barlow+Condensed:wght@500;600;700;800&family=Public+Sans:wght@400;500;600&display=swap">
<style>
/* Layout: matchday programme. Split-colour masthead, then stacked sections that always read Connacht left / Leinster right. */
:root{
  --bg:#f3f5f2; --surface:#ffffff; --ink:#132018; --muted:#5d6a62; --line:#dde3de;
  --con:#1f6b34; --con-soft:#d9eadc; --lei:#1d3a94; --lei-soft:#dbe2f5;
  --win:#2f8a3f; --loss:#c23b2e; --draw:#8a918c;
  --pitch:#2f6b3b; --crest-bg:transparent; --pitch-2:#357543; --pitch-line:rgba(255,255,255,.55);
  --display:"Barlow Condensed","Arial Narrow",Impact,sans-serif;
  --body:"Public Sans",system-ui,-apple-system,"Segoe UI",sans-serif;
}
@media (prefers-color-scheme:dark){:root:not([data-theme="light"]){
  --bg:#0e1411; --surface:#161e19; --ink:#e7eee9; --muted:#9aa8a0; --line:#27322b;
  --con:#4fb26a; --con-soft:#1c3324; --lei:#7d98f0; --lei-soft:#1c2541;
  --win:#4fb26a; --loss:#e0685c; --draw:#7d867f;
  --pitch:#1f4a29; --crest-bg:#eef2ef; --pitch-2:#24532f; --pitch-line:rgba(255,255,255,.4); color-scheme:dark}}
:root[data-theme="dark"]{
  --bg:#0e1411; --surface:#161e19; --ink:#e7eee9; --muted:#9aa8a0; --line:#27322b;
  --con:#4fb26a; --con-soft:#1c3324; --lei:#7d98f0; --lei-soft:#1c2541;
  --win:#4fb26a; --loss:#e0685c; --draw:#7d867f;
  --pitch:#1f4a29; --crest-bg:#eef2ef; --pitch-2:#24532f; --pitch-line:rgba(255,255,255,.4); color-scheme:dark}

body{background:var(--bg);color:var(--ink);font-family:var(--body);font-size:15px;line-height:1.5}
.wrap{max-width:1080px;margin:0 auto;padding-block:28px 64px;padding-left:max(16px,env(safe-area-inset-left,0px));padding-right:max(16px,env(safe-area-inset-right,0px));display:grid;gap:28px}
h1,h2,h3{font-family:var(--display);margin:0;text-wrap:balance;letter-spacing:.01em}
.eyebrow{font-family:var(--display);font-weight:600;text-transform:uppercase;letter-spacing:.14em;font-size:13px;color:var(--muted)}
.num{font-variant-numeric:tabular-nums}

/* Masthead */
.mast{display:grid;grid-template-columns:1fr auto 1fr;border-radius:14px;overflow:hidden;background:var(--surface);border:1px solid var(--line)}
.side{padding:22px 24px;display:grid;gap:10px;align-content:start}
.side.c{background:linear-gradient(120deg,var(--con-soft),transparent 85%)}
.side.l{background:linear-gradient(240deg,var(--lei-soft),transparent 85%);text-align:right;justify-items:end}
.team{font-size:clamp(34px,6vw,60px);font-weight:800;line-height:.9;text-transform:uppercase}
.c .team{color:var(--con)} .l .team{color:var(--lei)}
.crest{margin:0;line-height:0}
.crest img{display:block;height:clamp(84px,14vw,128px);width:auto;max-width:100%;background:none}
@media (max-width:560px){.crest img{height:88px}}
.vs{display:grid;place-items:center;padding:0 10px;font-family:var(--display);font-weight:700;font-size:22px;color:var(--muted)}
.form{display:flex;gap:5px;align-items:center}
.chip{width:26px;height:26px;border-radius:5px;display:grid;place-items:center;color:#fff;font-family:var(--display);font-weight:700;font-size:15px}
.chip.W{background:var(--win)} .chip.L{background:var(--loss)}
.rec{font-family:var(--display);font-size:18px;font-weight:600;color:var(--muted)}
@media (max-width:560px){.mast{grid-template-columns:1fr}.vs{padding:4px}.side.l{text-align:left;justify-items:start;background:linear-gradient(120deg,var(--lei-soft),transparent 85%)}}

.card{background:var(--surface);border:1px solid var(--line);border-radius:14px;padding:22px 24px;display:grid;gap:18px;min-width:0}
.head{display:flex;justify-content:space-between;align-items:end;gap:12px;flex-wrap:wrap}
.head h2{font-size:30px;font-weight:700;text-transform:uppercase}
.sub{color:var(--muted);max-width:62ch;margin:0}

/* Edge tally */
.tally{display:grid;grid-template-columns:auto 1fr auto;align-items:center;gap:14px}
.tally .big{font-family:var(--display);font-weight:800;font-size:56px;line-height:1}
.tally .big.c{color:var(--con)} .tally .big.l{color:var(--lei)}
.tbar{display:flex;height:14px;border-radius:7px;overflow:hidden;background:var(--line)}
.tbar span{display:block;transition:flex-grow .5s}
.tlabel{display:flex;justify-content:space-between;font-size:13px;color:var(--muted);margin-top:6px}

/* Filters */
.filters{display:flex;gap:6px;flex-wrap:wrap}
.filters button{font:600 14px var(--display);letter-spacing:.08em;text-transform:uppercase;padding:7px 12px;border-radius:999px;border:1px solid var(--line);background:transparent;color:var(--ink);cursor:pointer}
.filters button[aria-pressed="true"]{background:var(--ink);color:var(--surface);border-color:var(--ink)}
.filters button:focus-visible,.unit:focus-visible,.p:focus-visible{outline:2px solid var(--lei);outline-offset:2px}

/* Stat rows */
.group{display:grid;gap:2px}
.group h3{font-size:15px;font-weight:600;letter-spacing:.14em;text-transform:uppercase;color:var(--muted);padding:10px 0 6px;border-bottom:1px solid var(--line)}
.row{display:grid;grid-template-columns:76px 1fr 76px;gap:12px;align-items:center;padding:10px 6px;border-radius:8px;cursor:default}
.row:hover{background:var(--bg)}
.row .v{font-family:var(--display);font-weight:700;font-size:22px}
.row .v.r{text-align:right}
.row .v.lead::after{content:"";display:inline-block;width:7px;height:7px;border-radius:50%;margin:0 0 4px 6px;background:currentColor}
.row .v.c{color:var(--con)} .row .v.l{color:var(--lei)}
.row .v.dim{color:var(--muted)}
.mid{display:grid;gap:5px;min-width:0}
.lab{display:flex;justify-content:space-between;gap:8px;font-size:14px}
.lab .note{color:var(--muted);font-size:12.5px;white-space:nowrap;opacity:0;transition:opacity .15s}
.row:hover .note,.row:focus-within .note{opacity:1}
.split{position:relative;display:flex;height:8px;border-radius:4px;overflow:hidden;background:var(--line)}
.split .a{background:var(--con)} .split .b{background:var(--lei)}
.split .a,.split .b{transition:width .6s cubic-bezier(.2,.7,.2,1)}
.split::after{content:"";position:absolute;left:50%;top:-2px;bottom:-2px;width:2px;background:var(--surface)}
@media (max-width:480px){.row{grid-template-columns:58px 1fr 58px;gap:8px}.row .v{font-size:19px}.lab .note{display:none}}

/* Rings */
.rings{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:12px}
.ring{display:grid;gap:8px;justify-items:center;text-align:center;padding:12px 6px;border-radius:10px}
.ring:hover{background:var(--bg)}
.ring svg{width:100%;max-width:150px;height:auto}
.ring .t{font-family:var(--display);font-weight:600;font-size:17px;text-transform:uppercase;letter-spacing:.06em}
.ring .d{font-size:12.5px;color:var(--muted)}
@media (max-width:640px){.rings{grid-template-columns:repeat(2,minmax(0,1fr))}}

/* Margin chart */
.margins{display:grid;gap:18px}
.mrow{display:grid;grid-template-columns:90px 1fr;gap:12px;align-items:center}
.mrow .who{font-family:var(--display);font-weight:700;font-size:18px;text-transform:uppercase}
.mrow .who.c{color:var(--con)} .mrow .who.l{color:var(--lei)}
.scale{display:grid;grid-template-columns:repeat(10,1fr);gap:3px;min-width:0}
.cell{height:44px;border-radius:5px;background:var(--bg);border:1px solid var(--line);display:flex;align-items:center;justify-content:center;gap:3px;position:relative}
.cell.zero{border-left:2px solid var(--ink)}
.dot{width:14px;height:14px;border-radius:50%}
.dot.W{background:var(--win)} .dot.L{background:var(--loss)}
.axis{display:grid;grid-template-columns:90px 1fr;gap:12px}
.axis .ticks{display:grid;grid-template-columns:repeat(10,1fr);gap:3px;font-size:11.5px;color:var(--muted);text-align:center}
.legend{display:flex;gap:16px;font-size:13px;color:var(--muted);flex-wrap:wrap}
.legend span{display:inline-flex;align-items:center;gap:6px}
@media (max-width:520px){.mrow,.axis{grid-template-columns:1fr}.axis>div:first-child{display:none}.axis .ticks{font-size:10px}.cell{height:36px}.dot{width:11px;height:11px}}

/* Pitch */
.units{display:flex;gap:6px;flex-wrap:wrap}
.unit{font:600 14px var(--display);letter-spacing:.08em;text-transform:uppercase;padding:7px 12px;border-radius:999px;border:1px solid var(--line);background:transparent;color:var(--ink);cursor:pointer}
.unit[aria-pressed="true"]{background:var(--ink);color:var(--surface);border-color:var(--ink)}
.pitchbox{overflow-x:auto;border-radius:12px}
.pitch{position:relative;min-width:760px;aspect-ratio:2.05/1;background:repeating-linear-gradient(90deg,var(--pitch) 0 5%,var(--pitch-2) 5% 10%);border-radius:12px;overflow:hidden}
.pitch svg.lines{position:absolute;inset:0;width:100%;height:100%}
.p{position:absolute;transform:translate(-50%,-50%);display:grid;justify-items:center;gap:3px;width:96px;background:none;border:0;padding:0;cursor:pointer;transition:opacity .25s,transform .25s}
.p .av{width:44px;height:44px;border-radius:50%;display:grid;place-items:center;font-family:var(--display);font-weight:700;font-size:17px;color:#fff;border:2px solid rgba(255,255,255,.85);box-shadow:0 2px 6px rgba(0,0,0,.25)}
.p.c .av{background:#1f6b34} .p.l .av{background:#1d3a94}
.p .nm{font-size:12px;line-height:1.15;color:#fff;text-align:center;text-shadow:0 1px 2px rgba(0,0,0,.6)}
.pitch.focus .p{opacity:.22}
.pitch.focus .p.on{opacity:1;transform:translate(-50%,-50%) scale(1.12)}
.pitch-cap{display:flex;justify-content:space-between;font-family:var(--display);font-weight:700;text-transform:uppercase;letter-spacing:.1em;font-size:15px}
.pitch-cap .c{color:var(--con)} .pitch-cap .l{color:var(--lei)}
.matchup{min-height:1.5em;color:var(--muted);font-size:14px}
.matchup b{color:var(--ink);font-weight:600}

.foot{font-size:12.5px;color:var(--muted)}
.col{display:grid;gap:28px;align-content:start;min-width:0}
@media (min-width:1000px){
  .wrap{max-width:1440px;grid-template-columns:minmax(0,1fr) minmax(0,1.15fr);align-items:start}
  .wrap>header{grid-column:1/-1}
  .rings{gap:6px}
  .pitch{min-width:600px;aspect-ratio:1.6/1}
  .p{width:80px}
  .p .av{width:38px;height:38px;font-size:15px}
  .p .nm{font-size:11px}
}
@media (prefers-reduced-motion:reduce){*{transition:none!important}}
</style>

<div class="wrap">
  <header class="mast" aria-label="Fixture">
    <div class="side c">
      <div class="eyebrow">Home · left</div>
      <h1 class="crest"><img src="data:image/png;base64," alt="Connacht Rugby"></h1>
      <div class="form" aria-label="Connacht form"></div>
      <div class="rec num">P4 · W2 · L2 · D0</div>
    </div>
    <div class="vs">v</div>
    <div class="side l">
      <div class="eyebrow">Away · right</div>
      <h1 class="crest"><img src="data:image/png;base64," alt="Leinster Rugby"></h1>
      <div class="form" aria-label="Leinster form"></div>
      <div class="rec num">P4 · W2 · L2 · D0</div>
    </div>
  </header>

  <section class="card" aria-labelledby="edge-h">
    <div class="head">
      <div>
        <div class="eyebrow">League stats after 4 rounds</div>
        <h2 id="edge-h">Who leads more categories</h2>
      </div>
      <div class="filters" role="group" aria-label="Filter stat categories">
        <button data-f="all" aria-pressed="true">All</button>
        <button data-f="attack" aria-pressed="false">Attack</button>
        <button data-f="set" aria-pressed="false">Set piece</button>
        <button data-f="defence" aria-pressed="false">Defence</button>
        <button data-f="discipline" aria-pressed="false">Discipline</button>
      </div>
    </div>
    <div>
      <div class="tally">
        <div class="big c num" id="tc">0</div>
        <div>
          <div class="tbar"><span id="bc" style="background:var(--con);flex-grow:1"></span><span id="bt" style="background:var(--draw);flex-grow:0"></span><span id="bl" style="background:var(--lei);flex-grow:1"></span></div>
          <div class="tlabel"><span>Connacht lead</span><span id="tt">level</span><span>Leinster lead</span></div>
        </div>
        <div class="big l num" id="tl">0</div>
      </div>
    </div>
    <div id="stats"></div>
  </section>

  <div class="col">
  <section class="card" aria-labelledby="sp-h">
    <div class="head">
      <div>
        <div class="eyebrow">Set piece &amp; phases</div>
        <h2 id="sp-h">Success rates</h2>
      </div>
    </div>
    <div class="rings" id="rings"></div>
  </section>

  <section class="card" aria-labelledby="m-h">
    <div class="head">
      <div>
        <div class="eyebrow">Competition results</div>
        <h2 id="m-h">How close the games were</h2>
      </div>
      <div class="legend"><span><i class="dot W"></i>Win</span><span><i class="dot L"></i>Loss</span></div>
    </div>
    <div class="margins" id="margins"></div>
  </section>

  <section class="card" aria-labelledby="x-h">
    <div class="head">
      <div>
        <div class="eyebrow">Starting XVs</div>
        <h2 id="x-h">The line-ups</h2>
      </div>
      <div class="units" role="group" aria-label="Highlight a unit">
        <button class="unit" data-u="all" aria-pressed="true">All</button>
        <button class="unit" data-u="front" aria-pressed="false">Front row</button>
        <button class="unit" data-u="locks" aria-pressed="false">Locks</button>
        <button class="unit" data-u="back" aria-pressed="false">Back row</button>
        <button class="unit" data-u="halves" aria-pressed="false">Halves</button>
        <button class="unit" data-u="centres" aria-pressed="false">Centres</button>
        <button class="unit" data-u="three" aria-pressed="false">Back three</button>
      </div>
    </div>
    <div class="matchup" id="matchup"></div>
    <div class="pitch-cap"><span class="c">← Connacht</span><span class="l">Leinster →</span></div>
    <div class="pitchbox">
      <div class="pitch" id="pitch">
        <svg class="lines" viewBox="0 0 1000 488" preserveAspectRatio="none" aria-hidden="true">
          <g fill="none" stroke="var(--pitch-line)" stroke-width="2">
            <rect x="40" y="30" width="920" height="428"/>
            <line x1="110" y1="30" x2="110" y2="458"/><line x1="890" y1="30" x2="890" y2="458"/>
            <line x1="258" y1="30" x2="258" y2="458"/><line x1="742" y1="30" x2="742" y2="458"/>
            <line x1="500" y1="30" x2="500" y2="458"/>
            <line x1="382" y1="30" x2="382" y2="458" stroke-dasharray="10 10"/><line x1="618" y1="30" x2="618" y2="458" stroke-dasharray="10 10"/>
            <line x1="110" y1="60" x2="890" y2="60" stroke-dasharray="14 10"/><line x1="110" y1="428" x2="890" y2="428" stroke-dasharray="14 10"/>
            <line x1="110" y1="106" x2="890" y2="106" stroke-dasharray="14 18"/><line x1="110" y1="382" x2="890" y2="382" stroke-dasharray="14 18"/>
            <path d="M110 214 L60 210 M110 274 L60 278 M85 212 L85 276" stroke-width="3"/>
            <path d="M890 214 L940 210 M890 274 L940 278 M915 212 L915 276" stroke-width="3"/>
          </g>
        </svg>
      </div>
    </div>
  </section>
  </div>

</div>

<script>
const form={c:["L","W","L","W"],l:["L","L","W","W"]};
document.querySelectorAll(".form").forEach((el,i)=>{(i?form.l:form.c).forEach(r=>{const s=document.createElement("span");s.className="chip "+r;s.textContent=r;s.title=r==="W"?"Win":"Loss";el.appendChild(s)})});

// better: 1 higher wins, -1 lower wins, 0 no leader
const S=[
 {g:"attack",n:"Total tries scored",c:17,l:16,b:1},
 {g:"attack",n:"Tries per game",c:4.25,l:4,b:1},
 {g:"attack",n:"Total points scored",c:104,l:99,b:1},
 {g:"attack",n:"Points per game",c:26,l:24.75,b:1},
 {g:"attack",n:"Carries per game",c:117.5,l:130.5,b:1},
 {g:"attack",n:"Offloads per game",c:4.75,l:6.5,b:1},
 {g:"attack",n:"Passes per game",c:170.25,l:174.25,b:1},
 {g:"set",n:"Goal kick success",c:100,l:90,b:1,p:1},
 {g:"set",n:"Ruck success",c:97,l:96,b:1,p:1},
 {g:"set",n:"Scrum success",c:84,l:91,b:1,p:1},
 {g:"set",n:"Lineout success",c:93,l:86,b:1,p:1},
 {g:"defence",n:"Tackles made",c:697,l:423,b:0},
 {g:"defence",n:"Tackles missed",c:69,l:81,b:-1},
 {g:"defence",n:"Tackle success",c:91,l:84,b:1,p:1},
 {g:"discipline",n:"Penalties conceded",c:46,l:44,b:-1},
 {g:"discipline",n:"Penalties conceded per game",c:11.5,l:11,b:-1},
 {g:"discipline",n:"Penalties won",c:1,l:1,b:1},
 {g:"discipline",n:"Penalties won per game",c:0.25,l:0.25,b:1},
];
const G={attack:"Attack",set:"Set piece & phases",defence:"Defence",discipline:"Discipline"};
const fmt=(v,p)=>(Number.isInteger(v)?v:+v.toFixed(2))+(p?"%":"");
const lead=s=>s.b===0||s.c===s.l?null:((s.c>s.l)===(s.b>0)?"c":"l");
function note(s){
  if(s.b===0)return `Connacht made ${s.c-s.l} more (${(s.c/4).toFixed(0)} v ${(s.l/4).toFixed(0)} a game)`;
  const w=lead(s); if(!w)return "Level";
  const d=Math.abs(s.c-s.l);
  return `${w==="c"?"Connacht":"Leinster"} by ${fmt(+d.toFixed(2))}${s.p?" pts":""}`;
}
const statsEl=document.getElementById("stats");
function render(f){
  statsEl.innerHTML="";
  Object.keys(G).filter(g=>f==="all"||f===g).forEach(g=>{
    const box=document.createElement("div");box.className="group";
    box.innerHTML=`<h3>${G[g]}</h3>`;
    S.filter(s=>s.g===g).forEach(s=>{
      const w=lead(s),r=document.createElement("div");r.className="row";r.tabIndex=0;
      r.innerHTML=`<div class="v num c ${w==="c"?"lead":""} ${w==="l"?"dim":""}">${fmt(s.c,s.p)}</div>
      <div class="mid"><div class="lab"><span>${s.n}</span><span class="note">${note(s)}</span></div>
      <div class="split"><span class="a" style="width:50%"></span><span class="b" style="width:50%"></span></div></div>
      <div class="v r num l ${w==="l"?"lead":""} ${w==="c"?"dim":""}">${fmt(s.l,s.p)}</div>`;
      box.appendChild(r);
      requestAnimationFrame(()=>requestAnimationFrame(()=>{const tot=s.c+s.l||1;r.querySelector(".a").style.width=(s.c/tot*100)+"%";r.querySelector(".b").style.width=(s.l/tot*100)+"%"}));
    });
    statsEl.appendChild(box);
  });
  const set=S.filter(s=>(f==="all"||s.g===f)&&s.b!==0);
  const c=set.filter(s=>lead(s)==="c").length,l=set.filter(s=>lead(s)==="l").length,t=set.length-c-l;
  document.getElementById("tc").textContent=c;document.getElementById("tl").textContent=l;
  document.getElementById("bc").style.flexGrow=c;document.getElementById("bl").style.flexGrow=l;document.getElementById("bt").style.flexGrow=t;
  document.getElementById("tt").textContent=t?`${t} level`:"";
}
document.querySelectorAll(".filters button").forEach(b=>b.addEventListener("click",()=>{
  document.querySelectorAll(".filters button").forEach(x=>x.setAttribute("aria-pressed",x===b));render(b.dataset.f);
  try{localStorage.setItem("cl-filter",b.dataset.f)}catch(e){}
}));
let f0="all";try{f0=localStorage.getItem("cl-filter")||"all"}catch(e){}
(document.querySelector(`.filters [data-f="${f0}"]`)||document.querySelector(".filters button")).click();

// Rings
const ringsEl=document.getElementById("rings");
S.filter(s=>s.g==="set").forEach(s=>{
  const R1=54,R2=40,C1=2*Math.PI*R1,C2=2*Math.PI*R2;
  const d=document.createElement("div");d.className="ring";
  const w=lead(s);
  d.innerHTML=`<svg viewBox="0 0 140 140" role="img" aria-label="${s.n}: Connacht ${s.c}%, Leinster ${s.l}%">
    <circle cx="70" cy="70" r="${R1}" fill="none" stroke="var(--line)" stroke-width="11"/>
    <circle cx="70" cy="70" r="${R2}" fill="none" stroke="var(--line)" stroke-width="11"/>
    <circle class="arc" cx="70" cy="70" r="${R1}" fill="none" stroke="var(--con)" stroke-width="11" stroke-linecap="round" transform="rotate(-90 70 70)" stroke-dasharray="${C1}" stroke-dashoffset="${C1}" data-t="${C1*(1-s.c/100)}" style="transition:stroke-dashoffset 1s cubic-bezier(.2,.7,.2,1)"/>
    <circle class="arc" cx="70" cy="70" r="${R2}" fill="none" stroke="var(--lei)" stroke-width="11" stroke-linecap="round" transform="rotate(-90 70 70)" stroke-dasharray="${C2}" stroke-dashoffset="${C2}" data-t="${C2*(1-s.l/100)}" style="transition:stroke-dashoffset 1s .15s cubic-bezier(.2,.7,.2,1)"/>
    <text x="70" y="66" text-anchor="middle" font-family="Barlow Condensed,Arial Narrow,sans-serif" font-weight="700" font-size="22" fill="var(--con)">${s.c}%</text>
    <text x="70" y="88" text-anchor="middle" font-family="Barlow Condensed,Arial Narrow,sans-serif" font-weight="700" font-size="22" fill="var(--lei)">${s.l}%</text>
  </svg><div class="t">${s.n.replace(" success","")}</div><div class="d">${note(s)}</div>`;
  ringsEl.appendChild(d);
});
requestAnimationFrame(()=>requestAnimationFrame(()=>document.querySelectorAll(".arc").forEach(a=>a.style.strokeDashoffset=a.dataset.t)));

// Margins: bands L>28 .. L0-7 | W0-7 .. W>28
const bands=[">28","22–28","15–21","8–14","0–7","0–7","8–14","15–21","22–28",">28"];
const M={c:{W:[1,0,1,0,0],L:[0,1,1,0,0]},l:{W:[1,0,0,1,0],L:[2,0,0,0,0]}};
const mEl=document.getElementById("margins");
["c","l"].forEach(t=>{
  const row=document.createElement("div");row.className="mrow";
  let cells="";
  for(let i=0;i<10;i++){
    const isW=i>=5,k=isW?i-5:4-i,n=M[t][isW?"W":"L"][k];
    const lbl=`${n} ${isW?"win":"loss"}${n===1?"":isW?"s":"es"} by ${bands[i]} pts`;
    cells+=`<div class="cell ${i===5?"zero":""}" title="${lbl}" aria-label="${lbl}">${('<i class="dot '+(isW?"W":"L")+'"></i>').repeat(n)}</div>`;
  }
  row.innerHTML=`<div class="who ${t}">${t==="c"?"Connacht":"Leinster"}</div><div class="scale">${cells}</div>`;
  mEl.appendChild(row);
});
const ax=document.createElement("div");ax.className="axis";
ax.innerHTML=`<div></div><div class="ticks">${bands.map((b,i)=>`<span>${i<5?"L ":"W "}${b}</span>`).join("")}</div>`;
mEl.appendChild(ax);

// Pitch (coordinates taken from the source graphic)
const P=[
 ["c","Daniel Ryan",334,216,"three"],["c","Shayne Bolton",334,841,"three"],["c","Josh Ioane",271,529,"three"],
 ["c","Cathal Forde",398,425,"centres"],["c","John Devine",398,633,"centres"],
 ["c","Caolin Blade",525,425,"halves"],["c","Sean Naughton",525,633,"halves"],
 ["c","Sean F O'Brien",651,320,"back"],["c","Paul Boyle",651,529,"back"],["c","Will Connors",651,737,"back"],
 ["c","Josh Murphy",778,425,"locks"],["c","David O'Connor",778,633,"locks"],
 ["c","Francois van Wyk",905,320,"front"],["c","Dave Heffernan",905,529,"front"],["c","Finlay Bealham",905,737,"front"],
 ["l","Niall Smyth",1095,320,"front"],["l","Gus McCarthy",1095,529,"front"],["l","Alex Usanov",1095,737,"front"],
 ["l","Alan Spicer",1222,425,"locks"],["l","Brian Deeny",1222,633,"locks"],
 ["l","Scott Penny",1348,320,"back"],["l","James Culhane",1348,529,"back"],["l","Max Deegan",1348,737,"back"],
 ["l","Joey Carbery",1475,425,"halves"],["l","Fintan Gunne",1475,633,"halves"],
 ["l","Connor Fahy",1602,425,"centres"],["l","Charlie Tector",1602,633,"centres"],
 ["l","Joshua Kenny",1665,216,"three"],["l","Jordan Larmour",1665,841,"three"],["l","Todd Lawlor",1729,529,"three"],
];
const UN={front:"Front row",locks:"Locks",back:"Back row",halves:"Halves",centres:"Centres",three:"Back three"};
const pitch=document.getElementById("pitch"),mu=document.getElementById("matchup");
P.forEach(([t,n,x,y,u])=>{
  const b=document.createElement("button");b.className="p "+t;b.dataset.u=u;
  b.style.left=((x-40)/1920*100)+"%";b.style.top=((y-40)/980*100)+"%";
  const ini=n.replace("Sean F","Sean").split(" ").filter(w=>/^[A-Z]/.test(w)).map(w=>w[0]).slice(0,2).join("");
  b.innerHTML=`<span class="av">${ini}</span><span class="nm">${n.replace(" ","<br>")}</span>`;
  b.setAttribute("aria-label",`${n}, ${t==="c"?"Connacht":"Leinster"} ${UN[u]}`);
  b.addEventListener("click",()=>focusUnit(u));
  pitch.appendChild(b);
});
function focusUnit(u){
  document.querySelectorAll(".unit").forEach(x=>x.setAttribute("aria-pressed",x.dataset.u===u));
  if(u==="all"){pitch.classList.remove("focus");pitch.querySelectorAll(".p").forEach(p=>p.classList.remove("on"));mu.textContent="";return}
  pitch.classList.add("focus");
  pitch.querySelectorAll(".p").forEach(p=>p.classList.toggle("on",p.dataset.u===u));
  const names=t=>P.filter(p=>p[0]===t&&p[4]===u).map(p=>p[1]).join(", ");
  mu.innerHTML=`<b>${UN[u]}:</b> <span style="color:var(--con)">${names("c")}</span> &nbsp;v&nbsp; <span style="color:var(--lei)">${names("l")}</span>`;
}
document.querySelectorAll(".unit").forEach(b=>b.addEventListener("click",()=>focusUnit(b.dataset.u)));
</script>

</body></html>
